<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\De4DotCommon.props" />

  <PropertyGroup>
    <!-- Only force x86 if it's .NET Framework. If it's .NET Core, we must use AnyCPU so it can be started by 32-bit and 64-bit dotnet -->
    <PlatformTarget Condition=" '$(De4DotNetFramework)' == 'true' ">x86</PlatformTarget>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\de4dot.cui\de4dot.cui.csproj" />
  </ItemGroup>

   <ItemGroup>
    <LicenseFiles Include="$(MSBuildThisFileDirectory)\..\LICENSE.*" />
    <LicenseFiles Include="$(MSBuildThisFileDirectory)\..\COPYING" />
  </ItemGroup>

  <Target Name="CopyLicenseFiles_AfterBuild" AfterTargets="AfterBuild">
    <Copy SourceFiles="@(LicenseFiles)" DestinationFolder="$(TargetDir)LICENSES" />
  </Target>

  <Target Name="CopyLicenseFiles_Publish" AfterTargets="Publish">
    <Copy SourceFiles="@(LicenseFiles)" DestinationFolder="$(PublishDir)LICENSES" />
  </Target>

  <!--
    内置的 Eazfuscator.NET 字符串恢复后端。它必须和 de4dot 同目标框架构建，
    所以这里显式驱动一次，而不是用 ProjectReference（那会把它的程序集变成
    de4dot 的编译期依赖）。两个项目都输出到 Release\<tfm>\，构建完就在一起了。
  -->
  <Target Name="BuildEazWorker" BeforeTargets="Build">
    <!--
      先 Restore 再 Build：worker 不在解决方案里（避免成为 de4dot 的编译期依赖），
      所以解决方案的隐式还原不会覆盖它；CI 全新检出时它的 obj/project.assets.json
      不存在，直接 Build 会报 NETSDK1004。这里显式 Restore 一下。
    -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\de4dot.eazworker\de4dot.eazworker.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
  </Target>

  <!-- publish 只复制 de4dot 自己的输出，worker 需要单独带过去 -->
  <Target Name="CopyEazWorker_Publish" AfterTargets="Publish">
    <ItemGroup>
      <EazWorkerFiles Include="$(MSBuildThisFileDirectory)..\$(Configuration)\$(TargetFramework)\de4dot.eazworker*"
                      Exclude="$(MSBuildThisFileDirectory)..\$(Configuration)\$(TargetFramework)\*.pdb" />
    </ItemGroup>
    <Warning Text="de4dot.eazworker wasn't found; the published build can't recover modern Eazfuscator.NET strings on its own."
             Condition="'@(EazWorkerFiles)' == ''" />
    <Copy SourceFiles="@(EazWorkerFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="'@(EazWorkerFiles)' != ''" />
  </Target>

</Project>
